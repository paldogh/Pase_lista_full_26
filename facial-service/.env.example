# SQLAlchemy + psycopg. Use a dedicated DB/schema if possible.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Long random secret shared only between Node backend and this service
FACIAL_API_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Facenet512 cosine distance. 0.30 is an UNVALIDATED test starting point.
FACIAL_MAX_DISTANCE=0.30
FACIAL_MAX_IMAGE_BYTES=5242880
FACIAL_MODEL_NAME=Facenet512
FACIAL_DETECTOR_BACKEND=opencv
