# Variables para desarrollo local. En Render configúralas en Environment.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_CADENA_LARGA_Y_ALEATORIA
FRONTEND_URL=http://localhost:5173
# Dominios adicionales separados por coma (opcional).
ALLOWED_ORIGINS=http://localhost:5174
# Pool de conexiones; ajustar según el número de instancias y el límite de Neon.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
NODE_ENV=development
PORT=3000

# Correo (solo si se usa recuperación de contraseña).
EMAIL_USER=
EMAIL_PASS=

# WhatsApp (opcional).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=52
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT=
